{% extends "layout/app_shell.html" %}
{% load static humanize a11y %}

{#
  templates/organization/dashboard.html — DÉMO V5.G (migration vers app_shell).

  Avant : étendait `layout/admin_base_template.html` (legacy, palette
  divergente, pas de dark mode, drawer mobile vanilla cassé).

  Après : étend `layout/app_shell.html` (V5.C) :
  - sidebar mobile drawer Alpine avec focus-trap ;
  - dark mode unifié avec anti-FOUC ;
  - workspace switcher dans la topbar ;
  - logout en POST CSRF ;
  - skip-link a11y, ARIA partout ;
  - composants mutualisés : `kpi_card`, `course_card`, `empty_state`.

  Cette migration est un PATTERN à reproduire pour les autres écrans
  organization/*, instructor/*, learner/*, platform/* (V5 lourd).
#}

{% block title %}Dashboard — {{ organization.name }}{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block sidebar %}
  {% include "partials/organization_side.html" %}
{% endblock %}

{% block content %}
<div class="space-y-6">

  {# Hero compact (UX-43 : pas de hero géant). #}
  <header class="rounded-2xl bg-gradient-to-r from-be-sky-600 to-be-sky-700 text-white p-6 shadow-soft">
    <p class="text-sm opacity-80">Organisation</p>
    <h2 class="text-2xl font-bold mt-1">{{ organization.name }}</h2>
    <p class="text-sm opacity-80 mt-1">
      {{ kpis.members.total|default:0 }} membres ·
      {{ kpis.courses.total|default:0 }} cours ·
      {{ kpis.enrollments.active|default:0 }} inscriptions actives
    </p>
  </header>

  {# Bande KPI mutualisée (CQ-22). #}
  <section aria-label="Indicateurs clés"
           class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {% include "partials/kpi_card.html" with icon="fa-users" color="sky" label="Membres" value=kpis.members.total|intcomma hint="actifs uniquement" %}
    {% include "partials/kpi_card.html" with icon="fa-book-open" color="emerald" label="Cours publiés" value=kpis.courses.published|intcomma hint="company_only inclus" %}
    {% include "partials/kpi_card.html" with icon="fa-graduation-cap" color="amber" label="Inscriptions actives" value=kpis.enrollments.active|intcomma %}
    {% include "partials/kpi_card.html" with icon="fa-circle-check" color="indigo" label="Complétées" value=kpis.enrollments.completed|intcomma hint="cumulé" %}
  </section>

  {# Bloc cours récents. #}
  <section aria-labelledby="recent-courses-heading" class="space-y-3">
    <div class="flex items-center justify-between">
      <h3 id="recent-courses-heading" class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Cours récents
      </h3>
      <a href="{% url 'org:courses' organization_id=organization.id %}"
         class="text-sm text-be-sky-600 hover:text-be-sky-700 focus:outline-none focus:ring-2 focus:ring-be-sky-500 rounded">
        Voir tous les cours →
      </a>
    </div>

    {% if recent_courses %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for course in recent_courses %}
          {% include "partials/course_card.html" with course=course size="md" context="org" %}
        {% endfor %}
      </div>
    {% else %}
      {% include "partials/empty_state.html" with icon="fa-book-open" title="Aucun cours" message="Cette organisation n'a pas encore créé de cours." cta_label="Créer un cours" cta_url=create_course_url %}
    {% endif %}
  </section>

  {# Bloc instructeurs récents. #}
  <section aria-labelledby="recent-instructors-heading" class="space-y-3">
    <div class="flex items-center justify-between">
      <h3 id="recent-instructors-heading" class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        Formateurs récents
      </h3>
      <a href="{% url 'org:members' organization_id=organization.id %}"
         class="text-sm text-be-sky-600 hover:text-be-sky-700 focus:outline-none focus:ring-2 focus:ring-be-sky-500 rounded">
        Voir tous les membres →
      </a>
    </div>

    {% if recent_instructors %}
      <ul role="list" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-700 divide-y divide-slate-200 dark:divide-slate-800">
        {% for membership in recent_instructors %}
          <li class="p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-be-sky-100 text-be-sky-700 flex items-center justify-center font-semibold"
                 aria-hidden="true">
              {{ membership.user.full_name|default:membership.user.email|slice:":1"|upper }}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-slate-900 dark:text-slate-100 truncate">
                {{ membership.user.full_name|default:membership.user.email }}
              </p>
              <p class="text-xs text-slate-500 dark:text-slate-400">
                {{ membership.get_role_display }} · invité {{ membership.joined_at|naturaltime }}
              </p>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% include "partials/empty_state.html" with icon="fa-user-tie" title="Aucun formateur" message="Invitez un formateur depuis l'onglet Membres." %}
    {% endif %}
  </section>

</div>
{% endblock %}
