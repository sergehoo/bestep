{
  "name": "best-epargne-frontend",
  "version": "1.0.0",
  "description": "Frontend build (Tailwind + Alpine.js) — V5.E (UI-04).",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/app.css -o ./static/dist/app.min.css --minify",
    "watch:css": "tailwindcss -i ./static/src/app.css -o ./static/dist/app.css --watch",
    "build": "npm run build:css",
    "lint:css": "tailwindcss -i ./static/src/app.css -o /tmp/check.css --content '{templates,static}/**/*.{html,js}'"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/aspect-ratio": "^0.4.2"
  }
}
