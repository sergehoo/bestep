# ═══════════════════════════════════════════════════════════════════
# Best-Épargne — Variables d'environnement PRODUCTION (backend Django)
# ═══════════════════════════════════════════════════════════════════
# Copiez ce fichier en `.env` (jamais committé) sur le serveur cible.
# Toutes les variables marquées OBLIGATOIRE doivent être définies avant
# de lancer le container.
#
# Vérification pré-deploy : `deploy/preflight.sh`

# ──────────────────────────────────────────────────────────────
# Django core (OBLIGATOIRES)
# ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=best_epargne.settings.prod
# Générer avec : `python -c "import secrets; print(secrets.token_urlsafe(64))"`
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
DJANGO_ALLOWED_HOSTS=ayo-group.com,www.ayo-group.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ayo-group.com,https://www.ayo-group.com

# CORS (front sur domaine dédié). Ne PAS mettre `*` en prod.
DJANGO_CORS_ALLOWED_ORIGINS=https://ayo-group.com,https://www.ayo-group.com
DJANGO_CORS_ALLOW_CREDENTIALS=true

# ──────────────────────────────────────────────────────────────
# Base de données PostgreSQL (OBLIGATOIRE)
# ──────────────────────────────────────────────────────────────
POSTGRES_DB=best_epargne
POSTGRES_USER=best_epargne
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
DB_HOST=bestDB
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# ──────────────────────────────────────────────────────────────
# Redis (cache + sessions + Celery)
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ──────────────────────────────────────────────────────────────
# MinIO / S3 (uploads médias)
# ──────────────────────────────────────────────────────────────
MINIO_ENDPOINT=https://minio.ayo-group.com
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=be-media-prod
MINIO_REGION=us-east-1
MINIO_USE_SSL=true

# ──────────────────────────────────────────────────────────────
# Email SMTP (transactionnel + notifications)
# ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_ME_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=no-reply@ayo-group.com
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ──────────────────────────────────────────────────────────────
# Sécurité HTTPS / Cookies
# ──────────────────────────────────────────────────────────────
SECURE_HSTS_SECONDS=31536000
WHITENOISE_MAX_AGE=31536000

# ──────────────────────────────────────────────────────────────
# Upload limits (10 Mo par défaut)
# ──────────────────────────────────────────────────────────────
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ──────────────────────────────────────────────────────────────
# Observabilité (Sentry — optionnel)
# ──────────────────────────────────────────────────────────────
# Laisser vide pour désactiver. Nécessite `sentry-sdk` dans requirements.txt.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
DJANGO_LOG_FORMAT=json

# ──────────────────────────────────────────────────────────────
# Optionnel : OAuth (connexion sociale, roadmap R26)
# ──────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_ID=
