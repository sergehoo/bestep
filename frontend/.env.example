# R3 — Variables d'environnement frontend React.
# Copier en .env.local et adapter selon environnement.

# URL du backend Django REST API (SANS trailing slash, SANS /api)
# Dev : http://localhost:8000  (Vite proxy /api/* → cette URL)
# Staging : https://staging.ayo-group.com
# Prod : https://ayo-group.com
VITE_API_URL=http://localhost:8000

# Base URL de l'API (dérivée : ${VITE_API_URL}${VITE_API_BASE})
VITE_API_BASE=/api

# Nom affiché de l'app (title, header)
VITE_APP_NAME=Best Épargne

# Environnement (dev/staging/production)
VITE_ENV=development

# Optionnel : Sentry pour le monitoring des erreurs frontend
VITE_SENTRY_DSN=

# Optionnel : proxy Vite en dev (si backend Docker sur autre port)
VITE_DEV_API_PROXY=http://localhost:8000
